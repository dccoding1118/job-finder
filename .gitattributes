# Shell scripts must keep LF endings: a CRLF shebang makes the script
# unrunnable, and a Windows checkout would otherwise convert them on clone.
*.sh text eol=lf

# PowerShell is the Windows counterpart and is expected with CRLF there.
*.ps1 text eol=crlf

# Scheduling definitions are read by the platform, not by a shell.
*.service text eol=lf
*.timer   text eol=lf
*.xml     text eol=lf
