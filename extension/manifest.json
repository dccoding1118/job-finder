{
  "manifest_version": 3,
  "name": "jobfinder",
  "version": "0.1.0",
  "key": "",
  "description": "Local jobfinder dashboard",
  "options_page": "options/index.html",
  "background": { "service_worker": "service-worker.js" },
  "permissions": ["storage", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*", "http://[::1]/*"],
  "content_scripts": [
    {
      "matches": ["https://www.104.com.tw/jobs/search/*", "https://pda.104.com.tw/work/mate/list/*"],
      "js": ["content/list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.104.com.tw/job/*"],
      "js": ["content/job.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "jobfinder", "default_popup": "dashboard/index.html" }
}
